# Copia este archivo como .env.railway-backup y completa solo una de las dos opciones.

# Opcion A: URL completa
# BACKUP_DATABASE_URL=postgresql://usuario:password@host:puerto/base

# Opcion B: variables separadas
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Opcional: nombre amigable para la carpeta del backup
BACKUP_TENANT_SLUG=demo
